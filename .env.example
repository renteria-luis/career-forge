# Copy to .env.local and fill in. Values never go in the repository.

# --- Database -----------------------------------------------------------
# Plain Postgres over TCP. Neon's pooled connection string works as it is;
# nothing here may use a provider-specific driver or feature, so the database
# stays something a pg_dump can move.
#
# Put the database in the same region as the service. A database in Virginia
# behind a service in Iowa pays the round trip on every query.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Accounts -----------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it signs everyone out, which is also how to sign everyone out.
BETTER_AUTH_SECRET=

# The origin the app is reached at, used to build the links inside emails.
# http://localhost:3000 in development.
BETTER_AUTH_URL=http://localhost:3000

# --- Email --------------------------------------------------------------
# Verification and password-reset messages. Without these two, development
# prints the link to the terminal instead and production refuses to register
# anyone, rather than creating accounts nobody can reach.
RESEND_API_KEY=
EMAIL_FROM=Career Forge <noreply@example.com>

# --- Proxy --------------------------------------------------------------
# How many hops back from the end of X-Forwarded-For the real caller is.
# 1 behind Cloud Run alone; raise it if a CDN is put in front. See
# docs/deployment.md.
TRUSTED_PROXY_HOPS=1

# --- AI generation ------------------------------------------------------
# Create the key INSIDE a provider workspace that already has a spend limit,
# and never the other way round: a key made first can be spending before the
# ceiling exists. On a prepaid account the credit balance is that ceiling.
#
# Absence of this key is the feature flag. Without it every page still works
# and a resume still compiles; generation answers that it is unavailable. That
# is deliberately unlike RESEND_API_KEY, which a production build refuses to
# start without — an account nobody can reach is broken, a resume nobody asked
# a model about is not.
ANTHROPIC_API_KEY=

# The free provider, from Google AI Studio. Its free tier is trained on what it
# is sent, which is a decision somebody may make about their own resume and
# nobody may make about a stranger's — so this is personal mode only. See
# src/lib/ai/gemini.ts. Configure neither key and drafting is simply off.
GEMINI_API_KEY=
